# Streamlit's own chrome — dataframes, widgets, popovers — is not reachable
# from CSS: the dataframe is a <canvas>, so its colours have to come from here.
#
# This file used to be deliberately empty. The old reason was that setting ANY
# theme key made Streamlit force its built-in Plotly theme, which repainted
# every chart light even in dark mode. That no longer applies: every figure now
# goes through chart() in app.py, which passes theme=None and sets
# paper_bgcolor / plot_bgcolor explicitly, so Streamlit's chart theme has
# nothing left to override.
#
# base is pinned to "light" rather than left to follow the OS. The app defaults
# to its own light palette whatever the machine is set to, and if Streamlit
# followed prefers-color-scheme instead, a dark OS would render black
# dataframes inside a light dashboard — which is exactly the bug this fixes.
#
# KNOWN GAP: choosing Dark in the sidebar switches the app's own palette and
# every chart, but Streamlit's canvas dataframe stays light, because config is
# static and cannot follow a runtime choice. It affects the two table views.

[theme]
base = "light"

primaryColor = "#2a78d6"                  # palette blue, replacing Streamlit's
                                          # #ff4b4b — that red read as an alert
                                          # on every progress bar and chip, and
                                          # collided with the status palette's
                                          # "critical".
backgroundColor = "#eef4f9"               # page plane
secondaryBackgroundColor = "#fbfdfe"      # card / widget surface
textColor = "#0b1a24"
linkColor = "#2a78d6"

borderColor = "#dbe6ef"
dataframeBorderColor = "#dbe6ef"
dataframeHeaderBackgroundColor = "#e7eff7"

font = 'system-ui, -apple-system, "Segoe UI", sans-serif'
baseRadius = "9px"
buttonRadius = "8px"

[server]
headless = true
